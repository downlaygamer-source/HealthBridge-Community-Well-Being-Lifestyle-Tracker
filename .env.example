# ── HealthBridge Environment Configuration ──
# Copy this file to .env and adjust variables as needed

# Flask Secret Key for sessions
FLASK_SECRET_KEY=healthbridge-hackathon-2026-secret-key-national

# Server Port (Default: 5000)
PORT=5000

# SQLite Database Location (optional - default: instance/healthbridge.db)
# DATABASE_PATH=instance/healthbridge.db

# Flask Debug Mode (true / false)
FLASK_DEBUG=false
